          {
            "title": "공통 백엔드 템플릿·AI 개발 기준",
            "level": 3,
            "blocks": [
              {
                "kind": "paragraph",
                "text": "Python · FastAPI · SQLAlchemy 2.0 async · pytest",
                "claims": [
                  "be-template.fastapi-sqlalchemy-standard",
                  "be-template.tdd-development-harness"
                ],
                "presentation": "metadata"
              },
